# Public, build-time configuration. Copy to `.env.local` for local development.
# These are not secrets: both values ship in the client bundle.

# Formspree form ids (the last path segment of https://formspree.io/f/<id>).
NEXT_PUBLIC_FORMSPREE_JOIN_ID=
NEXT_PUBLIC_FORMSPREE_SUGGEST_ID=

# Optional: set when building for a project page, e.g. /chess-leaderboard.
NEXT_PUBLIC_BASE_PATH=
